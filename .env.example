# Database (Postgres)
# DATABASE_URL: pooled connection (app traffic). Provided by Neon.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
# DATABASE_URL_UNPOOLED: direct connection, used for migrations (Prisma directUrl).
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Cache / queue (Redis)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="" # generate: npx auth secret
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Torang Bisa <no-reply@example.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
